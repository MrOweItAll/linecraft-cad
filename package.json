{
  "name": "linecraft-cad",
  "version": "1.36.1-beta.4",
  "description": "Independent offline 2D drafting and polygonal 3D modeling for Windows",
  "author": "Linecraft contributors",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node desktop/dev-tools.cjs dev",
    "test": "node desktop/dev-tools.cjs test",
    "test:core": "node desktop/dev-tools.cjs test",
    "test:desktop": "node desktop/dev-tools.cjs test-desktop",
    "test:ordinary-grip": "node desktop/dev-tools.cjs test-desktop",
    "unpacked": "node desktop/dev-tools.cjs unpacked",
    "release": "node desktop/dev-tools.cjs release",
    "verify:source": "node tools/verify-public-source.cjs",
    "verify:packaged": "node tools/verify-public-source.cjs --packaged",
    "test:installed": "node desktop/dev-tools.cjs test-installed",
    "test:perpendicular": "node --test tests/perpendicular-independent.test.mjs",
    "test:completion": "node --test tests/command-completion.test.mjs",
    "test:trim": "node --test tests/trim-comprehensive.test.mjs",
    "qa:fast": "node tools/qa.cjs fast",
    "qa:application": "node tools/qa.cjs application",
    "qa:candidate": "node tools/qa.cjs candidate"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "org.linecraft.cad",
    "productName": "Linecraft CAD",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "Windows-Release",
      "buildResources": "desktop"
    },
    "files": [
      "index.html",
      "app.mjs",
      "core.mjs",
      "styles.css",
      "favicon.svg",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.ico",
      "LICENSE",
      "dwg-import.mjs",
      "desktop/import-files.cjs",
      "3d-view.mjs",
      "advanced-geometry.mjs",
      "plot-document.mjs",
      "desktop/plot-files.cjs",
      "units.mjs",
      "paper-space.mjs",
      "drawing-plane.mjs",
      "viewport-scales.mjs",
      "architecture/*.mjs",
      "linecraft-scripting.mjs",
      "desktop/script-control.cjs",
      "desktop/open-files.cjs",
      "context-menu-policy.mjs",
      "desktop/structural-files.cjs",
      "font-metrics.mjs",
      "rich-text.mjs",
      "desktop/drawing-resources.cjs",
      "object-snaps.mjs",
      "command-completion.mjs",
      "trim-geometry.mjs",
      "ordinary-grip-input.mjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Linecraft-CAD-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Linecraft CAD",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "license": "LICENSE"
    },
    "extraResources": [
      {
        "from": "third-party/libredwg",
        "to": "third-party/libredwg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/linecraft-structural-adapter.py",
        "to": "structural/linecraft-structural-adapter.py"
      }
    ]
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "node-gyp": {
      "undici": "6.29.1"
    },
    "@electron/get": {
      "undici": "7.30.1"
    }
  }
}
