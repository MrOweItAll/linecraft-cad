{
  "name": "linecraft-cad",
  "version": "1.12.1",
  "description": "Independent offline 2D drafting and polygonal 3D modeling for Windows",
  "author": "Linecraft contributors",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node dev-tools.cjs dev",
    "test": "node dev-tools.cjs test",
    "test:core": "node ../tests/run-tests.mjs",
    "test:units-math": "node --test ../tests/units-independent.test.mjs",
    "test:layouts-math": "node --test ../tests/layouts-independent.test.mjs",
    "test:layouts-security": "node ../tests/layouts-security.test.cjs",
    "test:viewport-math": "node ../tests/viewport-object-tests.mjs",
    "test:viewport-security": "node ../tests/viewport-security-v17.cjs",
    "test:units-desktop": "node dev-tools.cjs test-units",
    "test:layouts-desktop": "node dev-tools.cjs test-layouts",
    "test:viewports-desktop": "node dev-tools.cjs test-viewports",
    "test:viewport-navigation": "node dev-tools.cjs test-viewport-navigation",
    "test:paper-pdf": "node dev-tools.cjs test-pdf",
    "test:viewport-pdf": "node dev-tools.cjs test-viewport-pdf",
    "test:viewport-export": "node ../tests/export-viewport-v17.mjs",
    "test:scale-catalog": "node --test ../tests/viewport-scales.test.mjs",
    "test:scale-math": "node ../tests/viewport-scales-tests.mjs",
    "test:scale-security": "node ../tests/viewport-scales-security-v18.cjs",
    "test:scales": "node dev-tools.cjs test-scales",
    "test:scale-pdf": "node dev-tools.cjs test-scales-pdf",
    "test:desktop": "node dev-tools.cjs desktop",
    "test:converter": "node ../tests/converter-identity.cjs",
    "unpacked": "node dev-tools.cjs unpacked",
    "build": "node dev-tools.cjs build",
    "test:architecture": "node ../tests/run-architecture-tests.mjs",
    "test:architecture-ipc": "node ../tests/architecture-ipc.test.cjs",
    "test:architecture-desktop": "node dev-tools.cjs test-architecture",
    "test:space": "node ../tests/run-clearance-tests.mjs",
    "test:space-desktop": "node dev-tools.cjs test-space",
    "test:tray": "node ../tests/run-tray-tests.mjs",
    "test:tray-desktop": "node dev-tools.cjs test-tray",
    "test:gable": "node tests/run-gable-tests.mjs",
    "test:gable-desktop": "node desktop/dev-tools.cjs test-gable",
    "test:scripting": "node tests/run-scripting-tests.mjs",
    "test:scripting-desktop": "node desktop/dev-tools.cjs test-scripting"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "org.linecraft.cad",
    "productName": "Linecraft CAD",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "index.html",
      "app.mjs",
      "core.mjs",
      "styles.css",
      "favicon.svg",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.ico",
      "LICENSE",
      "dwg-import.mjs",
      "desktop/import-files.cjs",
      "3d-view.mjs",
      "advanced-geometry.mjs",
      "plot-document.mjs",
      "desktop/plot-files.cjs",
      "units.mjs",
      "paper-space.mjs",
      "drawing-plane.mjs",
      "viewport-scales.mjs",
      "architecture/*.mjs",
      "linecraft-scripting.mjs",
      "desktop/script-control.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Linecraft-CAD-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Linecraft CAD",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    },
    "extraResources": [
      {
        "from": "third-party/libredwg",
        "to": "third-party/libredwg",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
